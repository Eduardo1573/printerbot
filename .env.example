# =====================================================================
# Telegram printer bot — configuration. Copy to .env and fill in.
# NEVER commit .env.
# =====================================================================

# --- Telegram ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Static access code users send to the bot (min 8 chars). Generate one:
#   openssl rand -base64 18
AUTH_CODE=
# Brute-force protection: lock a Telegram user after N wrong codes.
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900

# --- Database ---------------------------------------------------------
# Default (Docker Compose): SQLite file on the persistent "botdata" volume.
# Uncomment only to use PostgreSQL instead:
# DATABASE_URL=postgresql+asyncpg://printerbot:PASSWORD@db-host:5432/printerbot

# --- Printer ----------------------------------------------------------
# Exact model from the printer's front label / configuration page, e.g.
# M130fw, M132fw, M130nw, M132nw, M132snw, M130fn, M132fn, M132fp, M133fn, M134fn.
PRINTER_MODEL=M130fw
# Printer's (reserved) LAN IP at home, reached through the WireGuard tunnel.
PRINTER_HOST=192.168.1.50
# IPP (AirPrint) port and path.
PRINTER_PORT=631
PRINTER_IPP_PATH=/ipp/print
# IPP over TLS (ipps://). Not needed inside the tunnel.
PRINTER_USE_TLS=false
PRINTER_VERIFY_TLS=false
PRINTER_PAPER_SIZE=a4
PRINTER_CONNECT_TIMEOUT=10

# --- Print limits -----------------------------------------------------
# Max 20: the public Telegram Bot API cannot download bigger files.
MAX_PDF_SIZE_MB=20
MAX_PDF_PAGES=100
# Seconds per job (conversion + upload + printing). ~22 ppm => allow
# roughly 30 s + 3 s/page. Jobs still printing at the deadline are NOT
# cancelled; jobs that never started are.
PRINT_TIMEOUT=300
MAX_CONCURRENT_PRINT_JOBS=1

# --- Scanning ---------------------------------------------------------
# email    : printer pushes scans via "Scan to E-mail" (M130fw / M132fw only)
# escl     : bot pulls scans via eSCL/AirPrint scanning (other network models;
#            verify first with: docker compose run --rm bot python -m app.tools.probe)
# disabled : printing only
SCAN_MODE=email
SCAN_REQUEST_TIMEOUT=300
# Telegram bots can send files up to 50 MB.
MAX_SCAN_SIZE_MB=45

# Built-in SMTP receiver (SCAN_MODE=email). Enter the same credentials in the
# printer's EWS → Scan → Outgoing E-mail Profiles.
SCAN_SMTP_USERNAME=printer
# Generate: openssl rand -hex 16
SCAN_SMTP_PASSWORD=
# Source networks allowed to deliver scans: the home LAN and/or the router's
# tunnel address (routers that NAT into the tunnel use their tunnel IP).
SCAN_SMTP_ALLOWED_NETWORKS=192.168.1.0/24,10.8.0.2/32
# none = plaintext inside the WireGuard tunnel (recommended).
SCAN_SMTP_TLS_MODE=none
# SCAN_SMTP_TLS_CERT=/run/secrets/smtp.crt
# SCAN_SMTP_TLS_KEY=/run/secrets/smtp.key
# Host address docker publishes the receiver on:
#   10.8.0.1  with the WireGuard tunnel (SCAN_MODE=email)
#   127.0.0.1 otherwise (no tunnel / eSCL / port forwarding)
SMTP_BIND_IP=127.0.0.1
SMTP_PUBLISHED_PORT=2525

# eSCL scanner (SCAN_MODE=escl)
ESCL_PORT=8080
ESCL_PATH=/eSCL
ESCL_USE_TLS=false
# Platen (glass) or Feeder (ADF, "f" models only)
ESCL_INPUT_SOURCE=Platen
ESCL_RESOLUTION=300
# RGB24 (color) | Grayscale8 | BlackAndWhite1
ESCL_COLOR_MODE=RGB24
# Multi-page scanning (📷 Scan → ➕ Scan more → 📄 Make document)
SCAN_SESSION_TIMEOUT=600
SCAN_MAX_PAGES=50

# --- Runtime ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
